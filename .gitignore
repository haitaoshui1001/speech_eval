# ---------------------------------------------------------------- 密钥，永远不进仓库
.env
.env.*
!.env.example
.secrets/
api_key.txt
*_key.txt
*_token.txt

# ---------------------------------------------------------------- 运行时数据（含真实学生音视频、账号、订单）
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------- 发布产物
dist/
build/
deploy/backup/

# ---------------------------------------------------------------- 大媒体样本
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.flac
# 冒烟测试依赖这个小样本（0.25 MB），单独放行
!tests/sample_speech.mp4

# ---------------------------------------------------------------- 本地调试残留
*.log
logs_*.txt
*.tmp
*.bak
_diff_*.txt
_diag/

# ---------------------------------------------------------------- Python / 工具链
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
.coverage
htmlcov/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
