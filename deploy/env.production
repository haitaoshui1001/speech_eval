# 服务器版配置模板。install.sh 会把本文件复制成 /opt/speech-assist/.env，
# 并把 __GENERATE__ / __SET_ME__ 两类占位符换成真实值。
# 已经存在 .env 时 install.sh 不会覆盖它（升级安全）。
#
# 也可以全部登录后在「系统设置」(/settings) 网页里改，保存即写回本文件并热生效；
# 只有 DATA_DIR / ENV_FILE / WEB_THREADS 这三项必须回到命令行或重启才生效。

# ===== 千问（阿里云百炼 DashScope）=====
# 密钥优先读同目录的 api_key.txt，这里留空即沿用。
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# real = 调用千问；mock = 无需 key 的演示模式；auto = 有 key 走 real，没有走 mock
LLM_MODE=auto

CHAT_MODEL=
VLM_MODEL=
OMNI_MODEL=
ASR_MODEL=

# 转录引擎：2C2G 上必须保持 qwen。改成 whisper 会加载本地模型（small 约 +2GB），
# 这台机器的内存直接不够，会 OOM。
ASR_ENGINE=qwen
WHISPER_MODEL_SIZE=small

# 三通道评审开关。两个都开时 token 消耗最高，但只影响账单不影响内存。
USE_VISION_CHANNEL=1
USE_AUDIO_CHANNEL=1

# ===== 站点 =====
# install.sh 生成随机值。改这一项会让所有人登录失效，需要重新登录。
SECRET_KEY=__GENERATE__
ADMIN_USERNAME=admin
# 首次启动时用它建管理员账号（只在账号不存在时生效，改了再重启不会改口令）。
# 之后改口令在登录后的 /settings 里；部署时也可以指定：
# sudo bash deploy/install.sh --admin-password '你的口令'
ADMIN_PASSWORD=__SET_ME__

# 2C2G / 3Mbps 出网：手机拍的 2~3 分钟视频通常 20~60MB，200MB 已足够宽裕，
# 调到 500 只会让上传排队和把 40GB 系统盘填满。nginx 的 client_max_body_size
# 由 install.sh 按这里的数字自动对齐。
MAX_VIDEO_MB=200
# 自动压缩目标。与上面那条上限是两件事：200MB 决定「收不收」，50MB 决定「收完存多大」。
# 超过 50MB 的在分析前用 ffmpeg 两遍编码压到 50MB 以内，压完删原件（原始体积与压缩说明留在库里）。
# 为什么要压：这台机器只有 40GB 系统盘，且 3Mbps 出网——回看一次 200MB 的原片约需 9 分钟，
# 压到 50MB 以内后约 2 分半，学生等得起。2C2G 上两遍编码是纯 CPU 活：32 核开发机实测压 1 分钟
# 1080p 用 5 秒，折算到 2 vCPU 约 80 秒/分钟素材，即一段 3 分钟 1080p 约 3~5 分钟压完；期间该任务
# 停在 queued（进度 4~7%），不影响别人上传与看报告。具体手机竖屏会更短（见部署手册第 10 节）。
COMPRESS_TARGET_MB=50
# 每一遍编码的超时（秒）。填大到能覆盖 200MB/15 分钟这种长片，超时保留原文件并报错，不会丢件。
COMPRESS_TIMEOUT=1800
# 可行性闸门：编码前先算「装不下/必超时/画质糊」，注定失败的在排队阶段就报错并给出路。
COMPRESS_FEASIBILITY=1
USER_UPLOAD_LIMIT=5
SESSION_DAYS=7

# ===== 关键帧 =====
FRAME_COUNT=12
FRAME_INTERVAL=5
FRAME_COUNT_MAX=100
FRAME_WIDTH=640

USE_FACE_METRICS=1
FACE_MIN_DETECT=0.5
FACE_MAX_FRAMES=120
# 同主题模糊匹配阈值：0.6 容错字与简称，主题相近但内容不同的会被拒。
TOPIC_MATCH_THRESHOLD=0.6

# ===== 并发与超时（按 2 人同时使用收紧）=====
# 实测（进程树峰值采样）：单路分析的增量内存是几十 MB 级，整个应用在 2 并发下
# 峰值约 500~600MB，所以 2GiB 内存够；真正的瓶颈是 3Mbps 出网带宽，不是内存。
# MAX_ANALYZERS 设 2 = 与"两个人同时点分析"刚好对齐；设更大也只是把 CPU 抢得更凶，
# 因为这台机器只有 2 个共享 vCPU，且没有 SLA 抖动余量。
MAX_ANALYZERS=2
MAX_LLM_REQUESTS=4
WEB_THREADS=32
REQUEST_TIMEOUT=180

# ===== 文字稿与朗读 =====
# 修订建议（报告页「生成修订建议」）。开关默认开，填 0 退回旧行为（不生成建议）。
REVISE_ENABLED=1
# 修订模型留空 = 跟随「文本评审通道」（CHAT_MODEL）。
REVISE_MODEL=
# 比对全稿单独一条超时预算（实测 1600 字稿子 349 秒），不要跟 180 秒的 REQUEST_TIMEOUT 混用。
REVISE_TIMEOUT=600
# 红线 R2：全部建议累计净增删不超过原文的 8%；红线 R5：风格类润色最多采纳 5 条。
REVISE_MAX_CHANGE_RATIO=8
REVISE_MAX_STYLE_ITEMS=5

# 朗读合成（在线 TTS）。填 0 关闭合成入口。
TTS_ENABLED=1
# 主选 qwen3-tts-instruct-flash（自然语言指令通道）；换 cosyvoice-* 即切数值参数通道。
TTS_MODEL=qwen3-tts-instruct-flash
# Neil = 男声、字正腔圆新闻腔；需女声改 Cherry。
TTS_VOICE=Neil
# 留空 = 从 QWEN_BASE_URL 推导 host；仅 CosyVoice 北京 workspace 需要填完整 URL。
TTS_ENDPOINT=
# 分块只在句边界切开：单块 ≤1600 字符、整篇 ≤8 块；超长稿由闸门直接拒绝，绝不偷偷放宽。
TTS_CHUNK_CHARS=1600
TTS_MAX_CHUNKS=8
# optimize_instructions：让模型把粗线条演绎指令细化执行。填 0 关闭。
TTS_INSTRUCTIONS=1
# 单个分块的 HTTP 超时（秒）。闸门按「块数 × 单块预算」预估整次耗时是否跑得完。
TTS_TIMEOUT=300

# 声音复刻（报告页「我的音色」）。填 0 只是关掉入口——授权记录与已建好的音色都保留，
# 填回 1 立即可用；关闭不影响学生删除自己音色的权利，别指望用这个开关「清数据」。
# 开启也只是放出入口：处理本人录音仍要每个学生单独勾选授权，随时可撤回并删除音色。
VOICE_CLONE_ENABLED=1
# 复刻音色绑定的合成模型。官方要求音色与模型死绑，改这一项 = 全站已建好的音色集体判
# 作废（页面会提示重做，学生重做一次即可，旧音色不会自动去远端删）。
# 除非官方发布新的 vc 模型，不要改这里。
TTS_VC_MODEL=qwen3-tts-vc-2026-01-22
