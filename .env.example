# ===== 千问（阿里云百炼 DashScope）=====
# 控制台获取：https://bailian.console.aliyun.com/?apiKey=1
# 也可以把 key 放在 api_key.txt（api key / base url / model），留空即沿用它
# 登录后访问 /settings 可用网页读写本文件，保存后立即生效、无需重启
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# real = 调用千问；mock = 无需 key 的演示模式；auto = 有 key 走 real，没有走 mock
LLM_MODE=auto

# 模型：填了就以这里为准；留空则用 api_key.txt 的 model
# （*-latest 变体在部分账号上是 403 access_denied，按需填写官方模型名）
CHAT_MODEL=
VLM_MODEL=
OMNI_MODEL=
ASR_MODEL=

# 转录引擎：qwen = 千问语音识别；whisper = 本地 faster-whisper（离线，需已下载模型）
ASR_ENGINE=qwen
WHISPER_MODEL_SIZE=small

# 评价通道：三通道（文本 / 图像 / 语音）分别判分后聚合融合
USE_VISION_CHANNEL=1
USE_AUDIO_CHANNEL=1

# ===== 站点 =====
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 上传硬上限：超过直接拒收，落盘前逐 MB 校验。
MAX_VIDEO_MB=500
# 自动压缩目标：收进来以后「存多大」。超过它就在分析前用 ffmpeg 两遍编码压到线内，
# 画质优先——码率够撑原分辨率就不降分辨率，不够才按 1080/720/540/480 短边阶梯降档。
# 填 0 表示完全不压缩；压缩失败或超时保留原文件并报错，不会静默拿超限文件继续分析。
COMPRESS_TARGET_MB=50
# 每一遍编码的超时上限（秒），两遍各算一次。
COMPRESS_TIMEOUT=1800
# 新账号默认可上传的视频个数；用完由管理员在后台单独重置或改额度。
USER_UPLOAD_LIMIT=5
SESSION_DAYS=7

# ===== 关键帧与微表情 =====
# 每 FRAME_INTERVAL 秒抽一张，等间隔均匀铺满整段，只做上限封顶（不做下限抬底）；
# FRAME_COUNT 只在时长探测失败时兜底。FRAME_WIDTH 不放大原始分辨率。
FRAME_COUNT=12
FRAME_INTERVAL=5
FRAME_COUNT_MAX=100
FRAME_WIDTH=640
# 正脸率/低头率/偏向等客观指标：只做质控证据，不直接改分。缺 opencv 时自动降级。
USE_FACE_METRICS=1
FACE_MIN_DETECT=0.5
FACE_MAX_FRAMES=120

# ===== 性能 =====
# 并发分析的视频个数 / 单次千问请求超时（秒）
MAX_ANALYZERS=2
REQUEST_TIMEOUT=180
