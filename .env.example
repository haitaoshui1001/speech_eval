# ===== 千问（阿里云百炼 DashScope）=====
# 控制台获取：https://bailian.console.aliyun.com/?apiKey=1
# 也可以把 key 放在 api_key.txt（api key / base url / model），留空即沿用它
# 登录后访问 /settings 可用网页读写本文件，保存后立即生效、无需重启
DASHSCOPE_API_KEY=
QWEN_BASE_URL=

# real = 调用千问；mock = 无需 key 的演示模式；auto = 有 key 走 real，没有走 mock
LLM_MODE=auto

# 模型：填了就以这里为准；留空则用 api_key.txt 的 model，两边都没填时走内置默认值
# （内置默认：qwen-plus / qwen-vl-max / qwen-omni-turbo-latest / qwen3-asr-flash）
# （*-latest 变体在部分账号上是 403 access_denied，按需填写官方模型名）
CHAT_MODEL=
VLM_MODEL=
OMNI_MODEL=
ASR_MODEL=

# 转录引擎：qwen = 千问语音识别；whisper = 本地 faster-whisper（离线，需已下载模型）
ASR_ENGINE=qwen
WHISPER_MODEL_SIZE=small

# 评价通道：三通道（文本 / 图像 / 语音）分别判分后聚合融合
USE_VISION_CHANNEL=1
USE_AUDIO_CHANNEL=1

# ===== 站点 =====
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 上传硬上限：超过直接拒收，落盘前逐 MB 校验。
MAX_VIDEO_MB=500
# 自动压缩目标：收进来以后「存多大」。超过它就在分析前用 ffmpeg 两遍编码压到线内，
# 画质优先——码率够撑原分辨率就不降分辨率，不够才按 1080/720/540/480 短边阶梯降档。
# 填 0 表示完全不压缩；压缩失败或超时保留原文件并报错，不会静默拿超限文件继续分析。
COMPRESS_TARGET_MB=50
# 每一遍编码的超时上限（秒），两遍各算一次。
COMPRESS_TIMEOUT=1800
# 可行性闸门：动手编码前先算三道题——目标装不下这个时长、按经验折算必然撞上超时、
# 降到底档画质仍会糊。前两道直接在排队阶段用中文说清原因和出路，不浪费几十分钟编码；
# 第三道放行但把告警写进报告。填 0 关闭闸门，退回旧行为（闷头跑完再失败）。
COMPRESS_FEASIBILITY=1
# 新账号默认可上传的视频个数；用完由管理员在后台单独重置或改额度。
USER_UPLOAD_LIMIT=5
SESSION_DAYS=7

# ===== 关键帧与微表情 =====
# 每 FRAME_INTERVAL 秒抽一张，等间隔均匀铺满整段，只做上限封顶（不做下限抬底）；
# FRAME_COUNT 只在时长探测失败时兜底。FRAME_WIDTH 不放大原始分辨率。
FRAME_COUNT=12
FRAME_INTERVAL=5
FRAME_COUNT_MAX=100
FRAME_WIDTH=640
# 正脸率/低头率/偏向等客观指标：只做质控证据，不直接改分。缺 opencv 时自动降级。
USE_FACE_METRICS=1
FACE_MIN_DETECT=0.5
FACE_MAX_FRAMES=120

# 历次对比的「同一个主题」按模糊匹配判定（写法差异、全半角、第3届/第三届都能归组）。
# 阈值越低归并越宽；短于 4 个字的主题只认完全相同。
TOPIC_MATCH_THRESHOLD=0.6

# ===== 性能 =====
# 并发分析的视频个数。出厂默认 10（够 10 人班课），2C2G 生产机按 deploy/env.production 收到 2
MAX_ANALYZERS=10
# 同时在途的千问请求个数（进程级闸门，与上一项分层：分析并发高不代表请求一定挤爆网关）
MAX_LLM_REQUESTS=20
# FastAPI 线程池大小。进程启动时读取，改完必须重启进程才生效（网页保存也救不回来）
WEB_THREADS=64
# 单次千问请求超时（秒）
REQUEST_TIMEOUT=180

# ===== 文字稿与朗读 =====
# 报告页的三项新能力（修订建议 / 示范朗读 / 声音复刻）都是新增能力：开关默认开，填 0 退回旧行为。
# 修订建议：报告页「生成修订建议」，五条红线里两条可按站点收紧。
REVISE_ENABLED=1
# 修订模型留空 = 跟随「文本评审通道」（CHAT_MODEL 的实际生效值）。
REVISE_MODEL=
# 比对全稿是整条链路最慢的一次调用（实测 1600 字稿子 349 秒），所以它不跟随 REQUEST_TIMEOUT，
# 单独一条更宽的预算；填小了会稳定卡在 35% 然后报超时。
REVISE_TIMEOUT=600
# 红线 R2：全部建议累计净增删不超过原文的 8%；红线 R5：风格类润色最多采纳 5 条。
REVISE_MAX_CHANGE_RATIO=8
REVISE_MAX_STYLE_ITEMS=5

# 朗读合成（在线 TTS）。填 0 关闭合成入口。
TTS_ENABLED=1
# 主选 qwen3-tts-instruct-flash（自然语言指令通道）；换 cosyvoice-* 即切数值参数通道。
TTS_MODEL=qwen3-tts-instruct-flash
# Neil = 男声、字正腔圆新闻腔；需女声改 Cherry。
TTS_VOICE=Neil
# 声音复刻总开关。填 0 只是关掉入口（报告页复刻节隐藏、授权/创建/删除三个 POST 一起拒绝），
# 不清授权记录也不删已建好的音色；填回 1 立即恢复可用。开启动工仍由每个学生自己勾选授权。
VOICE_CLONE_ENABLED=1
# 复刻音色绑定的合成模型。音色与模型死绑，改这一项会让已建好的音色全部判作废（需重做复刻）。
TTS_VC_MODEL=qwen3-tts-vc-2026-01-22
# 留空 = 从 QWEN_BASE_URL 推导 host；仅 CosyVoice 北京 workspace 需要填完整 URL。
TTS_ENDPOINT=
# 分块只在句边界切开：单块 ≤1600 字、整篇 ≤8 块；超长稿由闸门直接拒绝，绝不偷偷放宽。
TTS_CHUNK_CHARS=1600
TTS_MAX_CHUNKS=8
# optimize_instructions：让模型把粗线条演绎指令细化执行。填 0 关闭。
TTS_INSTRUCTIONS=1
# 单个分块的 HTTP 超时（秒）。闸门按「块数 × 单块预算」预估整次合成跑得完不跑得完。
TTS_TIMEOUT=300
